{
  "name": "briqbi-hr-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Express + MongoDB API — the security boundary between the public forms and the database. See README.md for status.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "start": "node dist/server.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
